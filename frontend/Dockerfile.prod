# 多阶段构建：构建阶段
FROM node:18-alpine AS builder

WORKDIR /app

# 复制package文件
COPY package*.json ./

# 安装依赖（包含 dev 依赖，确保构建工具链完整）
RUN npm ci

# 复制源代码
COPY . .

# 设置构建时环境变量（ARG 在构建时可用）
ARG REACT_APP_API_URL=https://welogx.com/api
ARG REACT_APP_EMPLOYEE_API_URL=https://welogx.com/api
ARG REACT_APP_GOOGLE_MAPS_API_KEY=AIzaSyB-uQvzsiFeJOr37qYg2EenJbaKUG7-KfE

# CI=false prevents treating warnings as errors during build
RUN CI=false \
    REACT_APP_API_URL=$REACT_APP_API_URL \
    REACT_APP_EMPLOYEE_API_URL=$REACT_APP_EMPLOYEE_API_URL \
    REACT_APP_GOOGLE_MAPS_API_KEY=$REACT_APP_GOOGLE_MAPS_API_KEY \
    npm run build

# 生产阶段：使用nginx服务静态文件
FROM nginx:alpine

# 复制构建后的文件到nginx目录
COPY --from=builder /app/build /usr/share/nginx/html

# 复制nginx配置文件
COPY nginx.conf /etc/nginx/nginx.conf

# 暴露端口
EXPOSE 80 443

# 启动nginx
CMD ["nginx", "-g", "daemon off;"]
