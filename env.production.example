# AWS生产环境配置示例
# 复制此文件为 .env.production 使用

# 环境模式
NODE_ENV=production
ENV_MODE=production

# 认证模式
AUTH_MODE=cognito

# 数据库配置（AWS RDS）
DB_HOST=${RDS_ENDPOINT}
DB_PORT=${RDS_PORT}
DB_NAME=${RDS_DB_NAME}
DB_USER=${RDS_USERNAME}
DB_PASSWORD=${RDS_PASSWORD}

# JWT密钥
JWT_SECRET=${JWT_SECRET}

# CORS配置
FRONTEND_URL=https://www.ewltl.com

# AWS Cognito配置
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_HU9W7uLQA
COGNITO_CLIENT_ID=5mae63uesfb6dia5l06ju4j5m0

