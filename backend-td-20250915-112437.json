        {
          "name": "RDS_DB_NAME",
          "value": "ewlogistics"
        },
        {
          "name": "RDS_USERNAME",
          "value": "ewjosh"
        },
        {
          "name": "RDS_PASSWORD",
          "value": "Ew95279527"
        },
        {
          "name": "JWT_SECRET",
