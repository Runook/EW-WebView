# =============================================
# AI Agent 报价自动化 - 环境变量配置
# =============================================

# --- 企业微信 (WeCom) ---
WECOM_CORP_ID=your_corp_id
WECOM_AGENT_SECRET=your_agent_secret
WECOM_AGENT_ID=your_agent_id
WECOM_CALLBACK_TOKEN=your_callback_token
WECOM_CALLBACK_AES_KEY=your_callback_encoding_aes_key

# --- DAT Freight API (RateView, Freight Posting, Search) ---
# Service Account credentials (shared org-level auth — Step 1)
DAT_SERVICE_EMAIL=your_service_account@example.com
DAT_SERVICE_PASSWORD=your_service_account_password
# Default user email for RateView (fallback when employee has no dat_email)
DAT_USER_EMAIL=your_default_user@example.com
# Environment: "production" | "staging" | "nprod"
# Use "nprod" for pre-certification testing (30–1000 tests per function)
DAT_API_ENV=production

# --- OpenClaw ---
OPENCLAW_WEBHOOK_URL=http://your-openclaw-instance:3000/webhook

# --- Agent Webhook Security ---
AGENT_WEBHOOK_API_KEY=your_secret_webhook_key
